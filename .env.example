# ==============================
# Campus Pulse — environment template
# Copy to .env and fill in real values. Never commit .env.
# ==============================

NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgres://campuspulse:campuspulse@localhost:5432/campuspulse
DATABASE_SSL=false

# --- Auth / tokens ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# --- App policy ---
MIN_AGE_YEARS=18
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Email provider (pick one; SMTP shown, swap for SES/SendGrid/Postmark in email.service.ts) ---
EMAIL_PROVIDER=console        # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Campus Pulse <no-reply@campuspulse.app>"

# --- Object storage (for profile photos — Phase 2+) ---
STORAGE_PROVIDER=local        # local | s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# --- Bot protection (optional; registration/login are safe without it thanks to
#     rate limiting + account lockout, but add this for public production launches) ---
CAPTCHA_PROVIDER=none          # none | turnstile | hcaptcha
CAPTCHA_SECRET_KEY=

# --- Logging / monitoring ---
LOG_LEVEL=info
# SENTRY_DSN=
